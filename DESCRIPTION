    cachem (>= 1.0.0),
    curl,
    digest,
    httr2 (>= 1.1.0),
    jsonlite,
    R6,
    stats,
    terra (>= 1.7-0),
    utils,
    zarr (>= 1.0.0)
Suggests:
    knitr,
    mirai (>= 2.3.0),
    rmarkdown,
